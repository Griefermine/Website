DISCORD_CLIENT_ID=deine-discord-client-id
DISCORD_CLIENT_SECRET=dein-discord-client-secret
BOT_HUB_OWNER_IDS=deine-discord-user-id
# Standardmäßig nur auf diesem Rechner erreichbar. Für bewussten LAN-Zugriff
# in Entwicklung HOST=0.0.0.0 setzen. In Produktion muss HOST=127.0.0.1 sein.
HOST=127.0.0.1
# Interner HTTP-Port des Hub. Diesen Port niemals im Router weiterleiten;
# öffentlich erreichbar ist ausschließlich der TLS-Reverse-Proxy auf 80/443.
PORT=8787
# Vite-Entwicklungsserver: bleibt ebenfalls lokal. Für LAN-Entwicklung
# VITE_HOST=0.0.0.0 setzen und nur den benötigten Port im LAN freigeben.
VITE_HOST=127.0.0.1
# Öffentliche Adresse: Discord-Redirect und Panel-Links. Die Bot-API nutzt in
# Produktion stattdessen automatisch das isolierte Docker-Gateway.
# Für den Betrieb auf einer Domain hier die https-Adresse eintragen und
# zusätzlich DISCORD_REDIRECT_URI sowie BOT_HUB_SECURE_COOKIES=1 setzen.
# HOST bestimmt nur, wo der öffentliche Hub lauscht; die Bot-API hat eine
# separate interne Adresse.
BOT_HUB_URL=http://127.0.0.1:8787
# Bot-Prozesse laufen standardmäßig in einem eigenen Docker-Container.
# Für Podman: BOT_HUB_CONTAINER_RUNTIME=podman
BOT_HUB_CONTAINER_RUNTIME=docker
BOT_HUB_CONTAINER_PREFIX=bot-hub
# In Produktion wird ausschließlich das interne Netz bot-hub-discord erlaubt.
# Es entsteht durch deploy/discord-egress/compose.yaml und leitet nur Discord
# über den Domainfilter weiter. Andere Produktionsnetze (auch bridge) sind gesperrt.
# BOT_HUB_CONTAINER_NETWORK=bot-hub-discord
# URL, unter der der Hub aus einem Container erreichbar ist. In Entwicklung
# schaltet diese Variable host.docker.internal frei. In Produktion ist sie
# gesperrt; der Hub stellt automatisch eine eigene, firewall-beschränkte
# Schnittstelle nur für die Bot-API bereit.
# BOT_HUB_CONTAINER_URL=http://host.docker.internal:8787
# Images je Sprache festnageln (JSON). Ohne diesen Wert folgt der Hub den
# Tags der Registry, beim Neustart also möglicherweise einer neuen Version.
# BOT_HUB_CONTAINER_IMAGES={"python":"python:3.12-bookworm@sha256:…"}
# Nur für Entwicklungs- oder Diagnosefälle, in denen Docker nicht zur Verfügung steht.
# Auskommentiert lassen – sonst laufen die Bots direkt auf dem Hub-Rechner.
# Mit NODE_ENV=production bricht der Start in diesem Fall ab.
# BOT_HUB_CONTAINER_MODE=disabled
# Hinter einem TLS-Reverse-Proxy: 1 erzwingt `Secure` auf allen Cookies.
# NODE_ENV=production reicht nur, wenn der Hub selbst weiß, dass er in Produktion läuft.
# BOT_HUB_SECURE_COOKIES=1
# Bot-Speicher: Datenbank für die Werte, die Bots über /api/hub/db ablegen.
# sqlite (Standard) braucht nichts weiter und legt eine Datei unter data/db/ an.
# BOT_HUB_DB=sqlite
# Anderer Ort für die SQLite-Datei. Außerhalb von data/ meldet der Hub das beim
# Start – im Startordner eines Bots dürfte sie nicht liegen, sonst könnte
# dieser sie direkt lesen und die API umgehen.
# BOT_HUB_DB_FILE=data/db/bot-hub.sqlite
# Für MySQL: eigener Benutzer mit Rechten nur auf diese eine Datenbank, kein root.
# Der Hub bricht den Start ab, sobald der Host nicht auf diesem Rechner liegt –
# erlaubt sind 127.0.0.1, ::1, localhost oder BOT_HUB_DB_SOCKET.
# BOT_HUB_DB=mysql
# BOT_HUB_DB_HOST=127.0.0.1
# BOT_HUB_DB_PORT=3306
# BOT_HUB_DB_NAME=bot_hub
# BOT_HUB_DB_USER=bot_hub
# BOT_HUB_DB_SOCKET=/run/mysqld/mysqld.sock
# Das Passwort gehört nach data/secrets/db.env (Modus 0600), nicht in diese Datei:
# BOT_HUB_DB_PASSWORD=…
#
# Eigene MySQL, die der Hub selbst aufsetzt. Ein Wert genügt:
#
#   BOT_HUB_DB=mysql-container
#
# Der Hub startet dann einen eigenen MySQL-Container, erzeugt zwei zufällige
# Passwörter (je 48 Zeichen), legt Datenbank und Arbeitsbenutzer an und schliesst
# den Admin-Zugang von aussen wieder – danach kann sich von ausserhalb niemand
# mehr als root anmelden, auch nicht mit dem Admin-Passwort. Das Arbeitspasswort
# landet in data/secrets/db.env (0600), das Admin-Passwort wird danach gelöscht.
# Bots kommen weiterhin nur über /api/hub/db an ihre Daten; der Container läuft
# an einem eigenen Netz und veröffentlicht nur auf 127.0.0.1.
#
# BOT_HUB_DB_NAME, BOT_HUB_DB_USER, BOT_HUB_DB_PORT, BOT_HUB_MYSQL_IMAGE,
# BOT_HUB_MYSQL_DATA, BOT_HUB_MYSQL_MEMORY und BOT_HUB_MYSQL_CPUS sind
# einstellbar. BOT_HUB_DB_HOST, BOT_HUB_DB_SOCKET und BOT_HUB_DB_PASSWORD
# werden abgelehnt – Adresse und Passwort stehen hier nicht zur Wahl.
# BOT_HUB_MYSQL_IMAGE=mysql:8.4
# BOT_HUB_MYSQL_DATA=data/mysql
# Wie lange der Hub auf den ersten Start von mysqld wartet (ms). Der erste Start
# initialisiert erst den Datenspeicher und dauert je nach Rechner eine Weile.
# BOT_HUB_MYSQL_STARTUP_TIMEOUT_MS=180000
# Datenbank neu aufsetzen: verwirft Container, Netz und data/mysql und legt alles
# mit neuen Passwörtern neu an. Danach sind ALLE Bot-Daten weg. Nötig, wenn das
# Passwort in data/secrets/db.env verloren ging – der Admin-Zugang existiert
# absichtlich nur einmal, es gibt also keinen zweiten Weg hinein.
# BOT_HUB_MYSQL_RESET=1
#
# Passwort erneuern, ohne dass ein Bot- oder Panel-Token sich ändert:
#   BOT_HUB_MYSQL_ROTATE=app     – Benutzer BOT_HUB_DB_USER
#   BOT_HUB_MYSQL_ROTATE=admin   – Benutzer BOT_HUB_MYSQL_ADMIN_USER
# Der Wert wird einmalig beim Start verarbeitet und danach nicht mehr beachtet.
# Beide Benutzer dürfen ihr eigenes Passwort mit ALTER USER USER() wechseln,
# wozu keine besonderen Rechte nötig sind – der Admin-Zugang existiert ja nicht
# mehr. Ohne Neustart wirksam, weil das hier vor dem Verbindungsaufbau passiert.
#
# --- phpMyAdmin -----------------------------------------------------------
#
# Optionale Verwaltungsoberfläche für diese Datenbank. Sie ist aus, bis man sie
# verlangt; ohne diesen Wert entsteht kein zweiter Container und kein zweites
# Datenbankpasswort.
#
#   BOT_HUB_PHPMYADMIN=1
#
# Der Container läuft als uid 33 mit cap-drop ALL und bekommt nichts vom Host:
# kein Volume, kein Mount, kein docker.sock. Er hängt am Netz von MySQL und
# veröffentlicht nur auf 127.0.0.1 – Bot-Container haben dorthin keine Route.
# Angemeldet wird sich selbst, es gibt kein PMA_USER und kein PMA_PASSWORD im
# Container; PMA_ARBITRARY=0 verhindert, dass die Oberfläche über die Adresse im
# Formular einen anderen Server ansteuert als das eigene MySQL.
#
# WICHTIG: Vor dem ersten Start setzen. Der Verwaltungsbenutzer entsteht im
# einmaligen Einrichten; danach gibt es keinen Adminzugang mehr, der ihn
# nachholen könnte, und der Hub sagt das auch deutlich, statt einen Container
# zu starten, an dem sich niemand anmelden kann.
#
# Anmelden als BOT_HUB_MYSQL_ADMIN_USER; das Passwort steht in
# data/secrets/phpmyadmin.env (0600). Von einem anderen Rechner aus per
# SSH-Tunnel: ssh -L 8081:127.0.0.1:8081 user@server
#
# Wieder abschalten: die Variable streichen. Beim nächsten Start stoppt der Hub
# den Container und sagt es ins Log; das Passwort bleibt liegen, damit sich die
# Oberfläche später mit demselben Benutzer wieder zuschalten lässt.
#
# BOT_HUB_PHPMYADMIN=1
# BOT_HUB_PHPMYADMIN_PORT=8081
# BOT_HUB_PHPMYADMIN_IMAGE=phpmyadmin/phpmyadmin:5.2.3
# BOT_HUB_PHPMYADMIN_MEMORY=512m
# BOT_HUB_PHPMYADMIN_CPUS=1
# BOT_HUB_MYSQL_ADMIN_USER=bot_hub_admin
#
# Callback-Ziele eines Bots: in Entwicklung per BOT_HUB_CALLBACK_ALLOW.
# Produktion liest die root-eigene Allowlist aus /etc/bot-hub/callback-egress.allow,
# die das UFW-Setup mit --callback-host HOST erzeugt. Extern nur HTTPS/443.
# BOT_HUB_CALLBACK_ALLOW=bot-gateway.example
#
# Images ohne Digest ablehnen. Ein Tag wie `python:3.12-bookworm` ist eine Liste
# von Namen, die jemand anderes jederzeit umschreiben kann. Mit `1` startet der
# Hub nicht, solange BOT_HUB_CONTAINER_IMAGES keine Digest-Referenzen nennt.
# In Produktion ohne diesen Schalter gibt es stattdessen eine deutliche Warnung.
# BOT_HUB_REQUIRE_IMAGE_DIGEST=1
#
# Vault-Master-Key (AES-256-GCM) für data/secrets/*.env. Der Schlüssel liegt
# absichtlich AUSSERHALB von data/ – deploy-full.sh erzeugt
# /etc/bot-hub/master.key (root:bot-hub 0640) und trägt die Zeile hier ein.
# Ohne Key schreibt der Hub Secrets als Klartext (altes Verhalten, Tests).
# BOT_HUB_KEY_FILE=/etc/bot-hub/master.key
#
# Verwaltetes MySQL (BOT_HUB_DB=mysql-container) und phpMyAdmin
# (BOT_HUB_PHPMYADMIN=1). Der Hub legt Netz, Container, Datenbank, Benutzer
# und Passwörter selbst an; die Passwörter liegen in data/secrets/ (Vault).
# Festes internes Netz: n+1 Gateway, n+2 MySQL, n+3 phpMyAdmin – die
# Anbindung läuft über diese Adressen, nicht über NAT-Publikationen (die in
# gehärteten Umgebungen fehlen können). Verlangt eine freie private CIDR.
# BOT_HUB_MYSQL_NETWORK_CIDR=172.30.252.0/24
# Einmalig setzen, um Container, Netz und data/mysql zu verwerfen (Achtung:
# alle Bot-Speicher-Daten verlieren) – danach wieder entfernen.
# BOT_HUB_MYSQL_RESET=1
# Einmalig: 'app' oder 'admin' – rotiert genau dieses Passwort beim Start.
# BOT_HUB_MYSQL_ROTATE=
