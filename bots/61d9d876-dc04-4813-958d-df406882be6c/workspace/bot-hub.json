{
  "hub": {
    "panel": {
      "title": "Rollen-Verwaltung",
      "icon": "🎛",
      "description": "Einstellungen und Schnellaktionen des Echo-Bots.",
      "entry": "panel/index.html",
      "settings": [
        {
          "key": "log_channel",
          "type": "text",
          "label": "Log-Kanal",
          "description": "Kanalname, in den der Bot seine Aktivität schreibt.",
          "default": "bot-log",
          "placeholder": "bot-log"
        },
        {
          "key": "auto_role",
          "type": "boolean",
          "label": "Auto-Rolle beim Beitritt",
          "default": true
        },
        {
          "key": "cooldown",
          "type": "number",
          "label": "Cooldown (Sekunden)",
          "description": "Wartezeit zwischen zwei Aktionen eines Nutzers.",
          "default": 5,
          "min": 0,
          "max": 300
        },
        {
          "key": "mode",
          "type": "select",
          "label": "Betriebsmodus",
          "default": "safe",
          "options": [
            { "value": "safe", "label": "Sicher" },
            { "value": "fast", "label": "Schnell" },
            { "value": "dry", "label": "Nur Loggen" }
          ]
        },
        {
          "key": "role_template",
          "type": "textarea",
          "label": "Rollen-Vorlage",
          "description": "Mehrzeilig – eine Berechtigung pro Zeile.",
          "default": "administrator\nmanage_roles"
        },
        {
          "key": "moderation_key",
          "type": "secret",
          "label": "Moderations-API-Key",
          "description": "Bleibt lokal gespeichert und wird nie ausgeliefert."
        },
        {
          "key": "command_role_create",
          "type": "boolean",
          "label": "/role_create aktiv",
          "default": true
        },
        {
          "key": "command_create_mass_roles",
          "type": "boolean",
          "label": "/create_mass_roles aktiv",
          "default": true
        },
        {
          "key": "command_rolle_erstellen",
          "type": "boolean",
          "label": "!rolle_erstellen aktiv",
          "default": true
        },
        {
          "key": "command_kategorie_erstellen",
          "type": "boolean",
          "label": "!kategorie_erstellen aktiv",
          "default": true
        },
        {
          "key": "command_kanal_erstellen",
          "type": "boolean",
          "label": "!kanal_erstellen aktiv",
          "default": true
        },
        {
          "key": "command_ping",
          "type": "boolean",
          "label": "!ping aktiv",
          "default": true
        }
      ],
      "commands": [
        {
          "id": "sync",
          "label": "Rollen synchronisieren",
          "description": "Prüft die Vorlage und meldet, was beim Bot fehlt.",
          "run": "python3 panel/commands/sync.py"
        },
        {
          "id": "announce",
          "label": "Status melden",
          "description": "Schreibt den aktuellen Betriebszustand in den Log-Kanal.",
          "run": "python3 panel/commands/announce.py"
        },
        {
          "id": "roles_list",
          "label": "Rollen laden",
          "description": "Lädt die aktuell auf dem Discord-Server vorhandenen Rollen."
        },
        {
          "id": "role_create_web",
          "label": "Rolle erstellen",
          "description": "Erstellt eine neue Rolle direkt über diese Webseite."
        },
        {
          "id": "role_update",
          "label": "Rolle bearbeiten",
          "description": "Ändert Name, Farbe und Anzeige einer Rolle."
        },
        {
          "id": "role_delete",
          "label": "Rolle löschen",
          "description": "Löscht eine Rolle dauerhaft vom Discord-Server.",
          "danger": true
        }
      ]
    }
  }
}
