# OAuth-Zugangsdaten für die Discord-Webseite dieses Bots.
# Diese Datei nach .env kopieren und nur lokal ausfüllen.
DISCORD_CLIENT_ID=deine-discord-client-id
DISCORD_CLIENT_SECRET=dein-discord-client-secret
# Alternativname für Installationen, die den Wert als Client-Token führen:
# DISCORD_CLIENT_TOKEN=dein-discord-client-token
DISCORD_OAUTH_URL=https://discord.com/oauth2/authorize
DISCORD_REDIRECT_URI=http://127.0.0.1:8787/api/bots/61d9d876-dc04-4813-958d-df406882be6c/panel/discord/callback
