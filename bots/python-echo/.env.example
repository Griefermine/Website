DISCORD_CLIENT_ID=deine-client-id
# erforderlich für den Code-Tausch auf dem Server
DISCORD_CLIENT_SECRET=dein-neues-client-secret
# Alternativname für Installationen, die den Wert als Client-Token führen:
# DISCORD_CLIENT_TOKEN=dein-client-token
# vollständige URL aus dem Discord Developer Portal
DISCORD_OAUTH_URL=https://discord.com/oauth2/authorize
DISCORD_REDIRECT_URI=http://127.0.0.1:8787/api/bots/<BOT-ID>/panel/discord/callback
